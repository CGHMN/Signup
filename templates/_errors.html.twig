{% if app.session.flashbag.peek('notice') %}
    <p>
        {% set first = true %}
        {% for message in app.flashes('notice') %}
            {% if first %}
                {{ message }}
            {% else %}
                <br>{{ message }}
            {% endif %}
            {% set first = false %}
        {% endfor %}
    </p>
{% endif %}

{% if app.session.flashbag.peek('error') %}
<ul>
    {% for message in app.flashes('error') %}
        <li>{{ message }}</li>
    {% endfor %}
</ul>
{% endif %}