{% set pages = [
    {'name': 'Requests', 'route': 'app.admin'},
    {'name': 'Admin Management', 'route': 'app.admin.manage'},
] %}

<div id="topbar">
    <h1 id="titlebar">{{ title }}</h1>
    <nav id="menubar">
        <ol>
            {% for page in pages %}
                {% if page.route != app.request.attributes.get('_route') %}
                    <a class="menu-item" href="{{ path(page.route) }}">
                        <li>{{ page.name }}</li>
                    </a>
                {% endif %}
            {% endfor %}
            <a class="menu-item" style="float: right;" href="{{ path('app.logout') }}">
                <li>Log Out</li>
            </a>
        </ol>
    </nav>
</div>