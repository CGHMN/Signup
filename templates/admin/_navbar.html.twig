{% set pages = [
    {'name': 'Requests', 'route': 'app.admin'},
    {'name': 'Users', 'route': 'app.admin.users'},
    {'name': 'Admin', 'route': 'app.admin.manage'},
    {'name': 'Email', 'route': 'app.admin.email'},
] %}

{% block stylesheets %}
<link rel="stylesheet" href="/theme/admin.css">
{% endblock %}

<div id="topbar">
    <h1 id="titlebar">{{ title }}</h1>
    <nav id="menubar">
        <ol>
            {% for page in pages %}
                <a class="menu-item" href="{{ path(page.route) }}">
                    <li>{{ page.name }}</li>
                </a>
            {% endfor %}
            <a class="menu-item" style="float: right;" href="{{ path('app.logout') }}">
                <li>Log Out</li>
            </a>
        </ol>
    </nav>
</div>