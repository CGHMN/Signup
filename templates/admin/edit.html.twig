{% extends 'base.html.twig' %}

{% set title = 'User Editing' %}
{% block title %}{{ title }}{% endblock %}

{% block body %}
{% include 'admin/_navbar.html.twig' %}
<h3 class="form-header">Edit User {{ userForm.vars.data.username }}</h3>
{{ form_start(userForm) }}
<table class="data-table">
    <tr>
        <td>Username</td>
        <td>{{ userForm.vars.data.username }}</td>
    </tr>
    <tr>
        <td>Email Address</td>
        <td>{{ userForm.vars.data.email }}</td>
    </tr>
    <tr>
        <td>Wireguard Peers</td>
        <td>{{ userForm.vars.data.wireguardPeers.count }}</td>
    </tr>
    {% set peerNum = 0 %}
    {% for peer in userForm.wireguardPeers %}
        {% set peerNum = peerNum + 1 %}
        <tr>
            <td><b>Wireguard Peer {{ peerNum }}</b></td>
            <td></td>
        </tr>
        <tr>
            <td>ID on Wireguard Router</td>
            <td>{{ peer.vars.data.routerID }}</td>
        </tr>
        <tr>
            <td>Tunnel IP</td>
            <td>{{ peer.vars.data.tunnelIP }}</td>
        </tr>
        <tr>
            <td>Routed Subnets</td>
            <td>
                {% set firstSubnet = true %}
                {% for subnet in peer.vars.data.allowedIPs %}
                    {% if firstSubnet %}
                        {{ subnet.cidr }}
                    {% else %}
                        ,{{ subnet.cidr }}
                    {% endif %}
                    {% set firstSubnet = false %}
                {% endfor %}
            </td>
        </tr>
        <tr>
            <td>Public Key</td>
            <td>
                {{ form_errors(peer.pubKey) }}
                {{ form_widget(peer.pubKey) }}
            </td>
        </tr>
        <tr>
            <td>Preshared Key</td>
            <td>{{ peer.vars.data.presharedKey }}</td>
        </tr>
    {% endfor %}
    <tr>
        <td>{{ form_row(userForm.submit, {label: 'Update'}) }}</td>
        <td></td>
    </tr>
</table>
{{ form_row(userForm._token) }}
{{ form_end(userForm, {render_rest: false}) }}

<h3 class="form-header">Create new Wireguard Peer for {{ userForm.vars.data.username }}</h3>
{{ form_start(peerForm) }}
<table>
    <tr>
        <td>{{ form_label(peerForm.pubKey) }}</td>
        <td>
            {{ form_errors(peerForm.pubKey) }}
            {{ form_widget(peerForm.pubKey) }}
        </td>
    </tr>
    <tr>
        <td>{{ form_row(peerForm.submit, {label: 'Update'}) }}</td>
        <td></td>
    </tr>
</table>
{{ form_row(peerForm._token) }}
{{ form_end(peerForm, {render_rest: false}) }}

{% endblock %}