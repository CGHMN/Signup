{% extends 'base.html.twig' %}

{% set title = 'CGHMN IP Allocations' %}
{% block title %}{{ title }}{% endblock %}

{% block body %}
{% include 'admin/_navbar.html.twig' %}

<table class="data-table">
    <tr>
        <th>Username</th>
        <th>Tunnel IP</th>
        <th>Routed Subnet(s)</th>
    </tr>
    {# Each allocation is displayed as a row in the table. #}
    {% for alloc in allocs %}
        <tr>
            <td>
                <a href="{{ path(name = 'app.admin.users.view', parameters = {id: alloc.id}, relative = true) }}">
                    {{ alloc.username }}
                </a>
            </td>
            <td>{{ alloc.tunnelIP }}</td>
            <td>
                {% set subnetNum = 0 %}
                {% for subnet in alloc.subnets %}
                    {% if alloc.subnets|length - 1 > subnetNum %}
                        {{ subnet.cidr }},
                    {% else %}
                        {{ subnet.cidr }}
                    {% endif %}
                    {% set subnetNum = subnetNum + 1 %}
                {% endfor %}
            </td>
        </tr>
    {% endfor %}
</table>

<div class="room">
    <h3 margin="10px 0">Total user count: {{ totalUsers }}</h3>
</div>

{% include '_errors.html.twig' %}
{% endblock %}
