{% extends 'base.html.twig' %}

{% set title = 'Admin Management' %}
{% block title %}{{ title }}{% endblock %}

{% block body %}
{% include 'admin/_navbar.html.twig' %}
{# TODO: Add some styling #}

<h1>Hello {{ app.user.username }}!</h1>
<h3>What would you like to do today?</h3>
<ul>
    <li>Change My Password</li>
    <li>Update My Account</li>
    {% if 'ROLE_SUPER_ADMIN' in app.user.roles %}
        <li><a href="{{ path('app.admin.new') }}">Create a New Admin</a></li>
    {% endif %}
    <li><a href="{{ path('app.logout') }}">Logout</a></li>
</ul>

{% endblock %}