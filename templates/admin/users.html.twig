{% extends 'base.html.twig' %}

{% set title = 'User Management' %}
{% block title %}{{ title }}{% endblock %}

{% block body %}
{% include 'admin/_navbar.html.twig' %}

{# Display the pending approval/rejection form #}
<h3 class="form-header">Users</h3>
{{ form_start(form) }}
<table class="data-table">
    <tr>
        <th>Username</th>
        <th>Email Address</th>
        <th>Plan</th>
        <th>Needs Hosting?</th>
        <th>Has Sysadmin Experience?</th>
        <th>Preferred Contact Method</th>
        <th>Contact Details</th>
        <th>Action</th>
    </tr>
    {# Each request is displayed as a row in the table. #}
    {% for request in form.requests %}
        <tr>
            <td>
                <a href="{{ path(name = 'app.admin.users.edit', parameters = {id: request.vars.data.id}, relative = false) }}">
                    {{ request.vars.data.username }}
                </a>
            </td>
            <td>{{ request.vars.data.email }}</td>
            <td>{{ request.vars.data.plan }}</td>
            <td>
                {% if request.vars.data.needsHosting %}
                    Yes
                {% else %}
                    No
                {% endif %}
            </td>
            <td>
                {% if request.vars.data.hasExperience %}
                    Yes
                {% else %}
                    No
                {% endif %}
            </td>
            <td>{{ request.vars.data.contactMethod }}</td>
            <td>{{ request.vars.data.contactDetails }}</td>
            <td>{{ form_widget(request.decision) }}</td>
        </tr>
    {% endfor %}
</table>
{{ form_row(form.submit) }}
{{ form_row(form._token) }}
{{ form_end(form, {render_rest: false}) }}

{# Display the notice/error list #}
{% include '_errors.html.twig' %}

{% endblock %}
