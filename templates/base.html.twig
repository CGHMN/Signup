<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {% block body %}{% endblock %}
        <div class="room">
            {% if app.user %}
                <p>You are logged in as {{ app.user.userIdentifier }}.
                <a href="{{ logout_path() }}">Logout</a>
            {% endif %}
            <p>Copyright (C) 2025-2026 CGHMN. GPLv3 or later.</p>
        </div>
    </body>
</html>
