{% extends 'base.html.twig' %}

{% set title = 'CGHMN Profile' %}
{% block title %}{{ title }}{% endblock %}

{% block body %}

<div class="room">

    <h1>Welcome {{ app.user.username }}!</h1>
    <h3>What would you like to do today?</h3>

    <ul>
        <li><a href="{{ path('app.profile.changePassword') }}">Change my Password</a></li>
        <li><a href="{{ path('app.profile.update') }}">Update my Profile</a></li>
        <li><a href="{{ path('app.profile.delete') }}">Delete my Account</a></li>
        <li><a href="{{ logout_path() }}">Log Out</a></li>
    </ul>

</div>

{% endblock %}
