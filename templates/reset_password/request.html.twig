{% extends 'base.html.twig' %}

{% block title %}Reset your password{% endblock %}

{% block body %}
    {% for flash_error in app.flashes('reset_password_error') %}
        <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
    {% endfor %}
    <h1>Reset your password</h1>

    {{ form_start(requestForm) }}
        {{ form_label(requestForm.email, 'Please enter your email address') }}
        {{ form_errors(requestForm.email) }}
        <br>
        {{ form_widget(requestForm.email) }}
        <button class="btn btn-primary">Send password reset email</button>
        <br><br>
        <p>An email will be sent to the given email address with instructions on how to reset your password.</p>
    {{ form_end(requestForm) }}
{% endblock %}
