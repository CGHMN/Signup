{% set pages = [
    {'name': 'Back', 'route': 'app.stats'},
    {'name': 'IPs', 'route': 'app.stats.allocations'},
] %}

{% block stylesheets %}
<link rel="stylesheet" href="/theme/admin.css">
{% endblock %}

<div id="topbar">
    <h1 id="titlebar">{{ title }}</h1>
    <nav id="menubar">
        <ol>
            {% for page in pages %}
                <a class="menu-item" href="{{ path(page.route) }}">
                    <li>{{ page.name }}</li>
                </a>
            {% endfor %}
        </ol>
    </nav>
</div>

{# Display the notice/error list #}
{% include '_errors.html.twig' %}
